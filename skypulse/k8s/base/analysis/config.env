# Non-secret settings for the analysis-zone workloads (api, analyzer).
# Kustomize turns this file into a ConfigMap named analysis-config-<hash>: any change
# produces a new name, which changes the pod templates and triggers a rolling update.
# Passwords never go here: the database login comes from the Secret analysis-db-credentials.
LOG_LEVEL=INFO
# Service "llm" in the same namespace
LLM_URL=http://llm:11434
# Empty = use the model baked into the LLM image
LLM_MODEL=
# "Recent" = posts from the last 7 days, capped at the 50 newest
SUMMARY_WINDOW_HOURS=168
SUMMARY_MAX_ITEMS=50
# Refresh every summary at least every 15 minutes
SUMMARY_MAX_AGE_SECONDS=900
# Standard libpq variables: the database lives in the data namespace
PGHOST=feeddb-rw.skypulse-data.svc.cluster.local
PGPORT=5432
PGDATABASE=skypulse
# CloudNativePG serves TLS out of the box
PGSSLMODE=require
