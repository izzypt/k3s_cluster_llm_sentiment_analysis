# Settings for the internet-facing ingestor (becomes ConfigMap ingestor-config-<hash>).
LOG_LEVEL=INFO
BSKY_API_BASE=https://api.bsky.app
POLL_INTERVAL_SECONDS=60
FETCH_LIMIT=50
# Standard libpq variables. The database lives in the data namespace, so we use the
# Service's fully-qualified DNS name: <service>.<namespace>.svc.cluster.local
PGHOST=feeddb-rw.skypulse-data.svc.cluster.local
PGPORT=5432
PGDATABASE=skypulse
# CloudNativePG serves TLS out of the box
PGSSLMODE=require
